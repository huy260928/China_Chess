# ============================================================================
# XIANGQI ENTERPRISE PLATFORM - ENVIRONMENT TEMPLATE
# ============================================================================

NODE_ENV=development
PORT=4000

# PostgreSQL Database
POSTGRES_USER=xiangqi
POSTGRES_PASSWORD=xiangqi_secret
POSTGRES_DB=xiangqi_db
DATABASE_URL="postgresql://xiangqi:xiangqi_secret@localhost:5432/xiangqi_db?schema=public"

# Redis Store
REDIS_URL="redis://localhost:6379"

# JWT Secrets
JWT_ACCESS_SECRET="xiangqi-enterprise-access-secret-key-2026"
JWT_REFRESH_SECRET="xiangqi-enterprise-refresh-secret-key-2026"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=7

# CORS Origin
CLIENT_ORIGIN="http://localhost:5173"
