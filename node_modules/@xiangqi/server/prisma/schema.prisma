// ============================================================================
// XIANGQI ENTERPRISE PLATFORM - PRISMA DATABASE SCHEMA (PostgreSQL)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MatchMode {
  PVP_RANKED
  PVP_CASUAL
  PVE_AI
}

enum MatchStatus {
  IN_PROGRESS
  COMPLETED
  ADJOURNED
  ABORTED
}

enum PlayerColor {
  RED
  BLACK
}

enum AiDifficulty {
  EASY
  MEDIUM
  HARD
}

enum MatchEndReason {
  CHECKMATE
  STALEMATE
  TIMEOUT
  RESIGNATION
  DRAW_AGREEMENT
  DRAW_REPETITION
  DRAW_FIFTY_MOVE
  DRAW_INSUFFICIENT_MATERIAL
  ADJOURNED
  ABANDONED
}

enum SavedMatchType {
  PVE
  PVP_ADJOURNED
}

enum SavedGameStatus {
  ACTIVE
  RESUMED
  COMPLETED
  EXPIRED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(32)
  email        String   @unique @db.VarChar(128)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  avatarUrl    String   @default("/avatars/default-general.png") @map("avatar_url") @db.VarChar(512)
  eloRating    Int      @default(1200) @map("elo_rating")
  gamesPlayed  Int      @default(0) @map("games_played")
  wins         Int      @default(0)
  losses       Int      @default(0)
  draws        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens      RefreshToken[]
  matchesAsRed       Match[]        @relation("MatchRedPlayer")
  matchesAsBlack     Match[]        @relation("MatchBlackPlayer")
  matchesWon         Match[]        @relation("MatchWinner")
  ownedSavedGames    SavedGame[]    @relation("SavedGameOwner")
  savedGamesAsRed    SavedGame[]    @relation("SavedGameRedPlayer")
  savedGamesAsBlack  SavedGame[]    @relation("SavedGameBlackPlayer")

  @@index([eloRating(sort: Desc)])
  @@index([username])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  userId    String    @map("user_id") @db.Uuid
  userAgent String?   @map("user_agent") @db.VarChar(512)
  ipAddress String?   @map("ip_address") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Match {
  id              String          @id @default(uuid()) @db.Uuid
  roomCode        String?         @map("room_code") @db.VarChar(32)
  mode            MatchMode       @default(PVP_RANKED)
  status          MatchStatus     @default(IN_PROGRESS)
  redPlayerId     String?         @map("red_player_id") @db.Uuid
  blackPlayerId   String?         @map("black_player_id") @db.Uuid
  aiDifficulty    AiDifficulty?   @map("ai_difficulty")
  winnerSide      PlayerColor?    @map("winner_side")
  winnerUserId    String?         @map("winner_user_id") @db.Uuid
  endReason       MatchEndReason? @map("end_reason")
  initialFen      String          @default("rnbakabnr/9/1c5c1/p1p1p1p1p/9/9/P1P1P1P1P/1C5C1/9/RNBAKABNR w - - 0 1") @map("initial_fen") @db.VarChar(255)
  finalFen        String          @map("final_fen") @db.VarChar(255)
  moveHistoryJson Json            @default("[]") @map("move_history_json")
  moveHistoryWxf  String          @default("") @map("move_history_wxf") @db.Text
  totalTimeMs     Int             @default(1800000) @map("total_time_ms")
  turnTimeMs      Int             @default(60000) @map("turn_time_ms")
  redTimeLeftMs   Int             @default(1800000) @map("red_time_left_ms")
  blackTimeLeftMs Int             @default(1800000) @map("black_time_left_ms")
  redEloBefore    Int?            @map("red_elo_before")
  blackEloBefore  Int?            @map("black_elo_before")
  redEloDelta     Int?            @map("red_elo_delta")
  blackEloDelta   Int?            @map("black_elo_delta")
  startedAt       DateTime        @default(now()) @map("started_at")
  endedAt         DateTime?       @map("ended_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  redPlayer   User?      @relation("MatchRedPlayer", fields: [redPlayerId], references: [id], onDelete: SetNull)
  blackPlayer User?      @relation("MatchBlackPlayer", fields: [blackPlayerId], references: [id], onDelete: SetNull)
  winnerUser  User?      @relation("MatchWinner", fields: [winnerUserId], references: [id], onDelete: SetNull)
  savedGame   SavedGame? @relation("OriginMatchSavedGame")

  @@index([redPlayerId, createdAt(sort: Desc)])
  @@index([blackPlayerId, createdAt(sort: Desc)])
  @@index([status])
  @@map("matches")
}

model SavedGame {
  id                 String          @id @default(uuid()) @db.Uuid
  matchType          SavedMatchType  @map("match_type")
  status             SavedGameStatus @default(ACTIVE)
  title              String?         @db.VarChar(128)
  ownerId            String          @map("owner_id") @db.Uuid
  redPlayerId        String?         @map("red_player_id") @db.Uuid
  blackPlayerId      String?         @map("black_player_id") @db.Uuid
  playerColor        PlayerColor     @default(RED) @map("player_color")
  aiDifficulty       AiDifficulty?   @map("ai_difficulty")
  initialFen         String          @default("rnbakabnr/9/1c5c1/p1p1p1p1p/9/9/P1P1P1P1P/1C5C1/9/RNBAKABNR w - - 0 1") @map("initial_fen") @db.VarChar(255)
  currentFen         String          @map("current_fen") @db.VarChar(255)
  turn               PlayerColor     @default(RED)
  moveHistoryJson    Json            @default("[]") @map("move_history_json")
  moveHistoryWxf     String          @default("") @map("move_history_wxf") @db.Text
  positionHashesJson Json            @default("[]") @map("position_hashes_json")
  totalTimeMs        Int             @default(1800000) @map("total_time_ms")
  turnTimeMs         Int             @default(60000) @map("turn_time_ms")
  redTimeLeftMs      Int             @default(1800000) @map("red_time_left_ms")
  blackTimeLeftMs    Int             @default(1800000) @map("black_time_left_ms")
  redReadyToResume   Boolean         @default(false) @map("red_ready_to_resume")
  blackReadyToResume Boolean         @default(false) @map("black_ready_to_resume")
  originMatchId      String?         @unique @map("origin_match_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  owner       User   @relation("SavedGameOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  redPlayer   User?  @relation("SavedGameRedPlayer", fields: [redPlayerId], references: [id], onDelete: SetNull)
  blackPlayer User?  @relation("SavedGameBlackPlayer", fields: [blackPlayerId], references: [id], onDelete: SetNull)
  originMatch Match? @relation("OriginMatchSavedGame", fields: [originMatchId], references: [id], onDelete: SetNull)

  @@index([ownerId, status])
  @@index([redPlayerId, status])
  @@index([blackPlayerId, status])
  @@map("saved_games")
}
